--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e41ecf4c2390fa24f80c77dd5df8b99b, type: 3}
  m_Name: Tier02EnvironmentLibrary
  m_EditorClassIdentifier: Assembly-CSharp::TheTrailWalker.Tier01EnvironmentLibrary
  Revision: 1
  DrawingContract: 'Reusable decorative art library for tier two (regions 7-12).
    Same contract as tier one: readable meshes, one opaque 32-colour palette material
    per region, separate shadow groups, no camp/route/reward/collider/save/scatter
    changes. Structure pieces (boardwalk, beaver lodge, beaver dam) are placed by
    route authoring only, never scattered and never on the road. Each regional material
    is a separate combine group; split tall shadow casters from noncasting ground
    cover. Opaque geometry only. All terrain/water modules require authored stitching/replacement
    and must not be layered coplanar with the live terrain or ribbon. Use the current
    ground-height projection and road/camp/resource clearance when placing. No live
    renderer/quality settings are changed.'
